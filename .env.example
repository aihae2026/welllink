# 이 파일은 예시 템플릿입니다. 실제 값은 여기에 적지 말고,
# 이 파일을 복사해 ".env.local" 이름으로 만든 뒤 그 파일에만 실제 값을 적으세요.
# ".env.local"은 .gitignore에 의해 GitHub에 절대 올라가지 않습니다.

# --- Supabase (v1.0 개발용 프로젝트) ---
# 공개키(publishable key / 구 anon key)는 브라우저에 노출되어도 되도록 설계된 키입니다 (RLS로 보호).
#
# 키 이름은 두 가지를 모두 지원합니다. 새로 설정한다면 README의 설치 안내와 같은
# VITE_SUPABASE_PUBLISHABLE_KEY를 쓰고 ANON_KEY 줄은 비워 두세요.
# (src/lib/supabase.ts가 PUBLISHABLE -> ANON 순서로 읽습니다. 둘 중 하나만 채우면 됩니다.)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# service_role key는 절대 이 파일이나 클라이언트 번들에 넣지 않습니다.
# 서버 전용 스크립트(seed/테스트 계정 생성 등)에서만, 커밋되지 않는 로컬 파일로 사용하세요.
#
# SUPABASE_SERVICE_ROLE_KEY (VITE_ 접두사 없음 -- 브라우저 번들에 절대 포함되지 않고
# src/lib/instructor-auth.ts의 createServerFn 핸들러 내부에서만, 서버에서만 읽힙니다.
# Cloudflare 배포 시에는 .env.local이 아니라 Worker의 secret binding으로 등록해야 합니다.)
SUPABASE_SERVICE_ROLE_KEY=

# --- AI 사업평가: Google Gemini Developer API ---
# VITE_ 접두사 없음 -- src/lib/ai-evaluation-server.ts의 createServerFn 핸들러
# 내부에서만, 서버에서만 읽힙니다. 클라이언트 번들에 절대 포함되지 않습니다.
GEMINI_API_KEY=

# --- 기관 초기등록 ---
# WELLLINK_PROVISIONING_TOKEN은 더 이상 쓰지 않습니다(2026-09-10 폐지).
# /provision은 이제 기관별 1회용 초대코드로만 동작하며, 초대코드는 공급자 기관의
# 관리자가 [운영설정 > 기관 초기등록]에서 발급합니다(14일 만료, 사용 즉시 소멸).
# 별도 환경변수가 필요 없습니다. 기존 .env.local / 배포 환경에 남아 있는 값은
# 삭제해도 됩니다. (배경: supabase/migrations/20260910080000_provisioning_invites.sql)
